LANGFUSE_PUBLIC_KEY=     # self-hosted Langfuse instance
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

AWS_ACCESS_KEY_ID=       # for Lambda deployment
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

HF_TOKEN=                # if pulling gated models from HuggingFace
